{
  "default": {
     "paths": [
     "src/features/**/*.feature"
    ],
    "require": [
      "src/step-definitions/**/*.ts",
      "src/support/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format": [
      "progress",
       "summary",
       "message",
      ["html", "reports/cucumber-report.html"],
      "allure-cucumberjs/reporter"
    ]
    
  }
}